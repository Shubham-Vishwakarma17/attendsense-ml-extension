# Operating system and editor files
.DS_Store
.idea/
.vscode/
*.swp

# JavaScript tooling
node_modules/
coverage/
npm-debug.log*
webapp/node_modules/
webapp/dist/
webapp/.env
webapp/.env.*
!webapp/.env.example
firebase-debug.log*
*-debug.log

# Firebase credentials must never be committed
**/service-account*.json
**/*-firebase-adminsdk-*.json
*.pem
*.key

# Python tooling (reserved for later checkpoints)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Private/local datasets; retain the directory placeholder
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
*.csv
*.tsv
*.parquet
*.jsonl

# Generated ML models and experiment artifacts
*.pkl
*.pickle
*.joblib
*.onnx
models/
artifacts/
runs/

# Keep the ML artifact directory, but never generated contents
!ml/artifacts/
ml/artifacts/*
!ml/artifacts/.gitkeep
ml/demo_artifacts/

# Packaged extension output
dist/
*.zip
